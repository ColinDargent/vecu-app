# Copier en `.env` (qui n'est jamais commité) et remplir avant `docker compose up`.
#
# Le PREMIER compte administrateur, créé au démarrage uniquement si la base est
# vide. Une fois le compte créé, ces deux lignes ne servent plus.
# Les deux vont ensemble. Le mot de passe fait 8 caractères minimum, sans quoi
# le serveur refuse de démarrer.
VECU_ADMIN_USER=
VECU_ADMIN_PASSWORD=
